<div class="img_box">
    <img src="/public/image/icon.png" alt="Mew_icon" width="80px" height="80px">
</div>
    <div class="box">
        <form method="POST" action="/login">
        <div class="letter_box">
            <div class="pink">
                <input class="login_input" type="text" name="username" placeholder="Username" required>
            </div>
            <div class="pink error_box">
                <% if (error) { %>
                    <p style="color:red"><%= error %></p>
                <% } %>
            </div>
            <div class="pink"> 
                <input class="login_input" type="password" name="password" placeholder="Password" required>
            </div>

            <div class="pink"></div>
            <div></div>
            <div class="pink"></div>
            <div></div>
            <div class="pink"></div>


            <div class="pink"></div>
            <div></div>
            <div class="pink">
                <button class="login_button" type="submit">Login</button>
            </div>
            <div></div>
            <div class="pink"></div>
        </div>
        </form>  
    </div>
