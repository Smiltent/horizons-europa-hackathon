<% if (error) { %>
    <p style="color:red"><%= error %></p>
<% } %>

<% if (created.length > 0) { %>
    <% created.forEach((proj) => { %>
        <div>
            <div>
                <div><%= proj.name %></div>
                <div><%= proj.isPublished %></div>
            </div>
            <div><%= proj.dateOfCreation %></div>
        </div>
    <% }) %>
<% } %>

<% if (nonCreated.length > 0) { %>
    <% nonCreated.forEach((proj) => { %>
        <div>
            <div>
                <div><%= proj.name %></div>
                <div>Not created</div>
            </div>
            <form method="POST" action="/projects/<%= proj.id %>/create">
                <button type="submit">Create</button>
            </form>
        </div>
    <% }) %>
<% } %>
