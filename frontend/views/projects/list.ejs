<div class="img_box">
    <img src="/public/image/icon.png" alt="Mew_icon" width="80px" height="80px">
</div>
<div class="e_box">
    <div class="inf_e_grid">
        <div class="pink"></div>
        <div class="error_box pink">
            <% if (error) { %>
                <p style="color:red"><%= error %></p>
            <% } %>
        </div>
        <div class="pink"></div>
        <% if (created.length > 0) { %>
        <% created.forEach((proj) => { %>
        <div class="pink"></div>
        <div></div>
        <div></div>
        <div></div>
        <div></div>

        <div class="pink"></div>
        <div class="pink"><%= proj.name %></div>
        <div class="pink"><%= proj.isPublished %></div>
        <div class="pink"><%= proj.dateOfCreation %></div>
        <div class="pink"></div>
            <% }) %>
        <% } %>
        <% if (nonCreated.length > 0) { %>
        <% nonCreated.forEach((proj) => { %>
        <div class="pink"></div>
        <div></div>
        <div></div>
        <div></div>
        <div></div>

        <div class="pink"></div>
        <div class="pink"><%= proj.name %></div>
        <div class="pink">Not created</div>
        <div class="pink">
            <button class="button" type="button" disabled title="Not available yet">Create</button>
        </div>
        <div class="pink"></div>
            <% }) %>
        <% } %>
    </div>
